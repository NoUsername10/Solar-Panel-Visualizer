{
  "name": "solar-panel-visualizer",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "description": "Home Assistant Lovelace custom card for visualizing solar panel arrays.",
  "scripts": {
    "build": "vite build",
    "build:release": "npm run build && cp dist/solar-panel-visualizer.js solar-panel-visualizer.js",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch",
    "test": "vitest run"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "solar"
  ],
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
